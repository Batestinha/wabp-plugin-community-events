        "id": "plugin.official.community-events.subgroupSuggestionConversion.policy",
        "path": "subgroupSuggestionConversion.policy",
        "label": "Subgroup suggestion conversion",
        "description": "Choose whether eligible WhatsApp community subgroup suggestions are ignored or automatically converted into fresh blank event-creation flows. Suggested group titles are discarded and never used as event prefill.",
        "section": "Community Events",
        "order": 30,
        "schema": {
          "type": "enum",
          "enum": [
            {
              "value": "off",
              "label": "Off"
            },
            {
              "value": "auto_convert",
              "label": "Automatically convert"
            }
          ]
        },
        "ui": {
          "widget": "segmented",
          "options": [
            {
              "value": "off",
              "label": "Off"
            },
            {
              "value": "auto_convert",
              "label": "Automatically convert"
            }
          ],
          "helpText": "Choose whether eligible WhatsApp community subgroup suggestions are ignored or automatically converted into fresh blank event-creation flows. Suggested group titles are discarded and never used as event prefill."
        },
        "dangerous": true,
        "confirmation": {
          "required": true,
          "message": "Automatically converting subgroup suggestions starts a fresh blank event-creation flow and then rejects the native WhatsApp suggestion. The suggested group title is discarded."
        },
        "relatedCommandIds": [
