      {
        "id": "plugin.official.community-events.subgroupSuggestionConversion.preFlowNotice.template",
        "path": "subgroupSuggestionConversion.preFlowNotice.template",
        "label": "Suggestion refusal notice text",
        "description": "Private text sent when an eligible native subgroup suggestion is detected, immediately before event setup. The exact suggestion is rejected only after initial flow delivery succeeds; suggested titles and other suggestion metadata are not available as template variables.",
        "section": "Community Events",
        "order": 50,
        "schema": {
